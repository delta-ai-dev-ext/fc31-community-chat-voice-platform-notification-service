# Local development only — never used in production (production reads the platform environment).
DATABASE_URL=postgres://notification:notification@localhost:5432/notification_service?sslmode=disable
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification_service
NOTIFICATION_EVENTS_TOPIC=notification_events
RESEND_API_KEY=re_dev_placeholder
MAIL_FROM_ADDRESS=notifications@example.com
MENTION_EMAIL_THROTTLE_WINDOW=15m
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=20s
# Apply the embedded schema migrations on startup (disable when the platform
# pipeline owns migrations).
RUN_MIGRATIONS=true

# Access-token verification (verify locally with identity_service public keys).
# Provide either a JWKS endpoint or a static PEM public key.
IDENTITY_JWKS_URL=
IDENTITY_JWT_PUBLIC_KEY=
JWT_ISSUER=identity_service
JWT_AUDIENCE=platform
